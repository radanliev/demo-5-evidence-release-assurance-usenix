{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .paperloop/run_gates.py:*)",
      "Bash(python3 .paperloop/loop.py:*)",
      "Bash(python3 .paperloop/checks/:*)",
      "Bash(make gate:*)",
      "Bash(make loop:*)",
      "Bash(make render:*)",
      "Bash(python3:*)",
      "Bash(latexmk:*)",
      "Bash(pdflatex:*)",
      "Bash(bibtex:*)",
      "Bash(biber:*)",
      "Bash(makeindex:*)",
      "Bash(pdftoppm:*)",
      "Bash(pdffonts:*)",
      "Bash(pdfinfo:*)",
      "Bash(pdftotext:*)",
      "Bash(qpdf:*)",
      "Read(./**)",
      "Grep(./**)",
      "Glob(./**)",
      "Bash(pytest:*)",
      "Bash(python3 scripts/:*)",
      "Bash(python3 eval/:*)",
      "Edit(./docs/**)",
      "Write(./docs/**)",
      "Edit(./.paperloop/state/**)",
      "Write(./.paperloop/state/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)"
    ],
    "ask": [
      "Edit(./.paperloop/venue.yaml)",
      "Write(./.paperloop/venue.yaml)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Edit(./.paperloop/checks/**)",
      "Write(./.paperloop/checks/**)",
      "Edit(./.paperloop/lib/**)",
      "Write(./.paperloop/lib/**)",
      "Edit(./.paperloop/run_gates.py)",
      "Write(./.paperloop/run_gates.py)",
      "Edit(./.paperloop/loop.py)",
      "Write(./.paperloop/loop.py)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*_key*)",
      "Read(./**/credentials*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .paperloop/hooks/post_edit_gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
